<?php
// ── Cloudinary Credentials ────────────────────────────────────────────────────
// Dashboard: https://cloudinary.com/console
// ⚠️ Add config/cloudinary.php to .gitignore — never commit secrets
// ─────────────────────────────────────────────────────────────────────────────
define('CLOUDINARY_CLOUD_NAME', 'YOUR_CLOUD_NAME');
define('CLOUDINARY_API_KEY',    'YOUR_API_KEY');
define('CLOUDINARY_API_SECRET', 'YOUR_API_SECRET');

/**
 * Uploads a file to Cloudinary using the Signed Upload API.
 *
 * Signature spec (Cloudinary):
 *   SHA1( "folder=<f>&timestamp=<t>&api_secret" )
 *   → all params sorted alphabetically, secret appended (NOT included in POST).
 *
 * @param  string $filePath  Temp server path of the uploaded file
 * @param  string $folder    Cloudinary folder (default: digipress/publications)
 * @return array             Cloudinary JSON response (secure_url, public_id, …)
 * @throws RuntimeException  on cURL failure or Cloudinary error response
 */
function cloudinaryUpload(string $filePath, string $folder = 'digipress/publications', string $resourceType = 'raw', int $limiter = 6000000, string $mimeType = '', string $type = 'upload'): array {

    $cloudName = CLOUDINARY_CLOUD_NAME;
    $apiKey    = CLOUDINARY_API_KEY;
    $apiSecret = CLOUDINARY_API_SECRET;
    $fileSize  = filesize($filePath);
    
    // If no mime type provided, try to detect it
    if (!$mimeType && function_exists('mime_content_type')) {
        $mimeType = mime_content_type($filePath);
    }
    
    $actualResourceType = $resourceType;

    // ── Cloudinary Hard Limit: 10 MB for PDFs ──────────────────────────────
    $cloudinaryMaxBytes = 10 * 1024 * 1024; // 10 MB
    if ($fileSize > $cloudinaryMaxBytes) {
        throw new RuntimeException(
            'PDF upload limit is 10MB. Please try to compress the file.'
        );
    }

    // Determine filename extension based on mime type
    $ext = 'bin';
    if ($mimeType === 'application/pdf') $ext = 'pdf';
    elseif (strpos($mimeType, 'image/') !== false) $ext = str_replace('image/', '', $mimeType);

    // Generate a consistent public_id with extension
    $publicId = 'pub_' . bin2hex(random_bytes(8)) . '.' . $ext;

    // ── If file is small, use standard upload ─────────────────────────────────
    if ($fileSize <= $limiter) {
        $timestamp = time();
        $signParams = [
            'folder'      => $folder,
            'public_id'   => $publicId,
            'timestamp'   => $timestamp,
            'type'        => $type,
        ];
        ksort($signParams);
        $signString = '';
        foreach ($signParams as $k => $v) $signString .= "$k=$v&";
        $signature = sha1(rtrim($signString, '&') . $apiSecret);

        $postFields = [
            'file'          => new CURLFile($filePath, $mimeType, "file.$ext"),
            'api_key'       => $apiKey,
            'timestamp'     => $timestamp,
            'signature'     => $signature,
            'public_id'     => $publicId,
            'folder'        => $folder,
            'type'          => $type,
            'resource_type' => $actualResourceType,
        ];

        $uploadUrl = "https://api.cloudinary.com/v1_1/{$cloudName}/{$actualResourceType}/upload";
        return _executeCloudinaryCurl($uploadUrl, $postFields);
    }

    // ── If file is large, use Chunked Upload ────────────────────────────────
    $uniqueId = bin2hex(random_bytes(16));

    $handle   = fopen($filePath, 'rb');
    $response = [];

    // Generate timestamp + signature ONCE for all chunks (same public_id, same params)
    $timestamp = time();
    $signParams = [
        'folder'      => $folder,
        'public_id'   => $publicId,
        'timestamp'   => $timestamp,
        'type'        => $type,
    ];
    ksort($signParams);
    $signString = '';
    foreach ($signParams as $k => $v) $signString .= "$k=$v&";
    $signature = sha1(rtrim($signString, '&') . $apiSecret);

    for ($start = 0; $start < $fileSize; $start += $limiter) {
        $end     = min($start + $limiter - 1, $fileSize - 1);
        $chunk   = fread($handle, $limiter);

        $tmpFile = tempnam(sys_get_temp_dir(), 'cl_chunk');
        file_put_contents($tmpFile, $chunk);

        $postFields = [
            'file'          => new CURLFile($tmpFile, $mimeType, "file.$ext"),
            'api_key'       => $apiKey,
            'timestamp'     => $timestamp,
            'signature'     => $signature,
            'public_id'     => $publicId,
            'folder'        => $folder,
            'chunk_size'    => $limiter,
            'type'          => $type,
            'resource_type' => $actualResourceType,
        ];

        $uploadUrl = "https://api.cloudinary.com/v1_1/{$cloudName}/{$actualResourceType}/upload";
        $headers = [
            "X-Unique-Upload-Id: $uniqueId",
            "Content-Range: bytes $start-$end/$fileSize",
        ];

        $response = _executeCloudinaryCurl($uploadUrl, $postFields, $headers);
        unlink($tmpFile);

        if (empty($response['public_id']) && $start + $limiter < $fileSize) {
            throw new RuntimeException('Chunk upload failed at byte ' . $start . '. Response: ' . json_encode($response));
        }
    }

    fclose($handle);
    return $response;
}

/**
 * Internal helper to execute Cloudinary cURL requests.
 */
function _executeCloudinaryCurl(string $url, array $postFields, array $headers = []): array {
    $ch = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_POST           => true,
        CURLOPT_POSTFIELDS     => $postFields,
        CURLOPT_HTTPHEADER     => $headers,
        CURLOPT_TIMEOUT        => 600,
        CURLOPT_SSL_VERIFYPEER => false,
    ]);

    $raw = curl_exec($ch);
    if (curl_errno($ch)) {
        $err = curl_error($ch);
        curl_close($ch);
        throw new RuntimeException("Cloudinary cURL error: $err");
    }
    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);

    $resp = json_decode($raw, true);

    // Log for debugging
    $logFile = __DIR__ . '/../cloudinary_upload.log';
    file_put_contents($logFile, '[' . date('Y-m-d H:i:s') . '] ' . json_encode($resp) . PHP_EOL, FILE_APPEND | LOCK_EX);

    if (empty($resp['secure_url']) && empty($resp['public_id'])) {
        $errMsg = $resp['error']['message'] ?? 'Unknown Cloudinary error';
        throw new RuntimeException("Cloudinary upload failed: $errMsg");
    }

    return $resp;
}

/**
 * Deletes a resource from Cloudinary by its public_id.
 * Resource type = 'raw' because PDFs are uploaded as raw.
 */
function cloudinaryDelete(string $publicId, string $resourceType = 'raw'): bool {
    $apiKey    = CLOUDINARY_API_KEY;
    $apiSecret = CLOUDINARY_API_SECRET;
    $cloudName = CLOUDINARY_CLOUD_NAME;
    $timestamp = time();

    $signParams = [
        'public_id' => $publicId,
        'timestamp' => $timestamp,
    ];
    ksort($signParams);
    
    $signPairs = [];
    foreach ($signParams as $key => $val) {
        $signPairs[] = "$key=$val";
    }
    $signString = implode('&', $signPairs) . $apiSecret;
    $signature  = sha1($signString);

    $postFields = [
        'public_id' => $publicId,
        'api_key'   => $apiKey,
        'timestamp' => $timestamp,
        'signature' => $signature,
    ];

    $url = "https://api.cloudinary.com/v1_1/{$cloudName}/{$resourceType}/destroy";
    $ch  = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_POST           => true,
        CURLOPT_POSTFIELDS     => $postFields,
        CURLOPT_TIMEOUT        => 30,
    ]);
    $resp = json_decode(curl_exec($ch), true);
    curl_close($ch);

    return ($resp['result'] ?? '') === 'ok';
}

/**
 * Updates an existing asset to have public access mode.
 */
function cloudinaryMakePublic(string $publicId, string $resourceType = 'raw'): bool {
    $apiKey    = CLOUDINARY_API_KEY;
    $apiSecret = CLOUDINARY_API_SECRET;
    $cloudName = CLOUDINARY_CLOUD_NAME;
    $timestamp = time();

    $signParams = [
        'access_mode' => 'public',
        'public_id'   => $publicId,
        'timestamp'   => $timestamp,
        'type'        => 'upload',
    ];
    ksort($signParams);
    
    $signPairs = [];
    foreach ($signParams as $key => $val) $signPairs[] = "$key=$val";
    $signature = sha1(implode('&', $signPairs) . $apiSecret);

    $postFields = [
        'public_id'   => $publicId,
        'access_mode' => 'public',
        'api_key'     => $apiKey,
        'timestamp'   => $timestamp,
        'signature'   => $signature,
        'type'        => 'upload',
    ];

    $url = "https://api.cloudinary.com/v1_1/{$cloudName}/{$resourceType}/explicit";
    $ch  = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_POST           => true,
        CURLOPT_POSTFIELDS     => $postFields,
        CURLOPT_TIMEOUT        => 30,
        CURLOPT_SSL_VERIFYPEER => false,
    ]);
    $resp = json_decode(curl_exec($ch), true);
    curl_close($ch);

    return !empty($resp['public_id']);
}

